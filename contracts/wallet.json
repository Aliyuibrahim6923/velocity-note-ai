{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WalletSchema",
  "type": "object",
  "properties": {
    "asset": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["real_estate", "vehicle", "appliance", "investment", "other"] },
        "value": { "type": "number" },
        "purchase_date": { "type": "string", "format": "date" },
        "maintenance_cycle_days": { "type": "integer" }
      },
      "required": ["id", "name", "type", "value"]
    },
    "transaction": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string", "enum": ["cash", "bank_webhook"] },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "transaction_date": { "type": "string", "format": "date-time" },
        "is_verified": { "type": "boolean" }
      },
      "required": ["id", "source", "amount", "type", "description", "transaction_date", "is_verified"]
    }
  }
}
